{
  // Cloudflare Pages Functions config (Mission 14 — espace admin + licences,
  // Cloudflare D1 au lieu de Supabase, decision architecte 07/07/2026).
  //
  // CORRECTION (Etape 3, 28/07/2026) : ce fichier n'est PAS local-dev-only --
  // Cloudflare Pages le LIT en production (fonctionnalite en beta) et il
  // PRIME sur la config du dashboard. Un `database_id` placeholder ici a
  // fait echouer le deploiement des Functions ("Invalid database UUID") sur
  // au moins 2 deploiements consecutifs (voir TASKS.md) -- le commentaire
  // precedent affirmant le contraire etait faux et trompeur, corrige ici.
  // database_id ci-dessous est le vrai UUID de la base D1 de production
  // (affiche par `wrangler d1 create` / le dashboard -- ce n'est pas un
  // secret, juste un identifiant de ressource).
  "name": "gds-amadeus-simulateur",
  "compatibility_date": "2026-07-27",
  "pages_build_output_dir": "apps/web/dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gds-licences",
      "database_id": "6af85642-3628-4f14-bac9-7794c89124f3"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CONTENT",
      "bucket_name": "gds-content"
    }
  ]
}
