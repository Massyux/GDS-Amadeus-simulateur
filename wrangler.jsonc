{
  // Cloudflare Pages Functions config (Mission 14 — espace admin + licences,
  // Cloudflare D1 au lieu de Supabase, decision architecte 07/07/2026).
  //
  // Local-dev-only file: production is a classic dashboard-configured Pages
  // project (see CLAUDE.md Phase 2 deploiement history) whose build command
  // and D1 binding are set in the Cloudflare dashboard, not read from here.
  // This file exists so `wrangler d1 execute --local` and `wrangler pages
  // dev` know the "DB" binding name during local development/tests
  // (missions/MISSION-14.md Etape 0: develop entirely against D1 local
  // before Massy touches production).
  "name": "gds-amadeus-simulateur",
  "compatibility_date": "2026-07-27",
  "pages_build_output_dir": "apps/web/dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gds-licences",
      // Placeholder: production's real database_id is assigned when Massy
      // runs "Workers & Pages -> D1 -> Create database" (see README.md
      // "Administration"). Irrelevant for --local execution, which only
      // uses database_name to key its local SQLite file.
      "database_id": "local-dev-placeholder"
    }
  ]
}
